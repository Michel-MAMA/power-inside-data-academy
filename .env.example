# ============================================================================
# POWER INSIDE DATA ACADEMY — Variables d'environnement
# Copier en .env.local (dev) / configurer dans Vercel (production)
# Documentation détaillée : INTEGRATION_SUPABASE.md
# ============================================================================

# ── Site ────────────────────────────────────────────────────────────────────
# URL publique du site (sans slash final). Utilisée pour les redirections
# auth, les URLs de retour paiement et les webhooks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠️ SECRET — jamais exposé au client. Utilisé par les webhooks de paiement
# (bypass RLS pour mettre à jour payments.status). Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Stripe ──────────────────────────────────────────────────────────────────
# Dashboard Stripe → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Dashboard Stripe → Developers → Webhooks → add endpoint :
#   https://votre-domaine.com/api/payments/stripe/webhook
# Événements : checkout.session.completed, checkout.session.expired,
#              payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Orange Money (Web Payment) ──────────────────────────────────────────────
# https://developer.orange.com — produit "Orange Money Web Pay"
# Laisser vide tant que le compte marchand n'est pas approuvé :
# l'API répondra proprement "bientôt disponible".
ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=

# ── MTN Mobile Money (Collections) ──────────────────────────────────────────
# https://momodeveloper.mtn.com — produit "Collection"
# MTN_MOMO_ENVIRONMENT : sandbox | mtncameroon | mtncongo | ...
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=

# ── Emails (Nodemailer, optionnel) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@pida.com
EMAIL_TO=contact@pida.com
